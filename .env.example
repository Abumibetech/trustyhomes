# Copy this file to .env for local development if you use a tool like
# django-environ / python-dotenv, OR just set these as real environment
# variables in your shell / hosting dashboard (e.g. Render's "Environment" tab).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Leave DATABASE_URL unset locally to use SQLite automatically.
# On Render, this is filled in for you when you attach a PostgreSQL database.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# The WhatsApp number (with country code, digits only) shown in the footer's
# chat bubble and used for "request a plan upgrade" links.
SITE_WHATSAPP_NUMBER=2348000000000

# --- Persistent photo storage (recommended before launch) -----------------
# Render's (and most PaaS) web-service disk is EPHEMERAL — uploaded photos
# are wiped on every redeploy without this. Free tier: https://cloudinary.com
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_URL=

# --- Maps ---------------------------------------------------------------
# No setup needed! Property locations use free OpenStreetMap/Leaflet maps
# (no API key, no billing, works immediately) instead of Google Maps.

# --- Email (for "forgot password" links) -----------------------------------
# Without these, reset emails just print to the server console/logs — fine
# for local dev, not for real users. Example values for Gmail SMTP below.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=TrustyHomes <you@gmail.com>
